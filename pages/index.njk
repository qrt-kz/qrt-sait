<script>
  // Телефондағы мәзір: ашу/жабу
  const burger = document.querySelector('.burger');
  const menu = document.querySelector('.menu');
  burger.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
  });
  menu.addEventListener('click', e => {
    if (e.target.tagName === 'A') { menu.classList.remove('open'); burger.setAttribute('aria-expanded', false); }
  });
</script>
<script>
  // #refund сілтемесімен келгенде сұрақты ашып көрсету
  function openRefund(){ const d=document.getElementById('refund'); if(location.hash==='#refund'&&d){ d.open=true; d.scrollIntoView({block:'center'}); } }
  window.addEventListener('load', openRefund); window.addEventListener('hashchange', openRefund);
</script>
</body>
</html>
