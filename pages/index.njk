<link rel="stylesheet" href="style.css?v=36">
</head>
<body>

<header>
  <div class="wrap nav">
    <a href="#" class="logo"><img src="assets/logo.png" alt="QAZAQ RESMI TEST" width="293" height="92"></a>
    <button class="burger" aria-label="Мәзір" aria-expanded="false">☰</button>
    <nav class="menu">
      <a href="#about">Тест туралы</a>
      <a href="#steps">Қалай тапсырамын?</a>
      <a href="#price">Бағасы</a>
      <a href="nuskaulyk.html">Нұсқаулық</a>
      <a href="zhuye.html">Жүйе туралы</a>
      <a href="zhanalyqtar.html">Жаңалықтар</a>
      <a href="#faq">Сұрақ-жауап</a>
      <a href="#contact">Байланыс</a>
      <a class="lang" href="ru.html" hreflang="ru">RU</a>
      <a class="btn btn-blue" href="https://test.qrt.kz/login">Кіру</a>
      <a class="btn btn-blue" href="https://test.qrt.kz/register">Тіркелу</a>
    </nav>
  </div>
</header>

<!-- Басты блок -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-sub">{{ hero.kz.sub }}</div>
      <h1>{{ hero.kz.title }}</h1>
      <p class="lead">{{ hero.kz.lead }}</p>
      <div class="hero-btns">
        <a class="btn btn-main" href="https://test.qrt.kz/register">Тестке тіркелу →</a>
        <a class="btn btn-line" href="#steps">Қалай тапсырылады?</a>
      </div>
    </div>
    <figure class="cert-wrap">
      <div class="cert" role="img" aria-label="Сертификат үлгісі">
        <div class="cert-in">
          <div class="cert-top">
            <img class="cert-logo" src="assets/cert-logo.jpg" alt="QAZAQ RESMI TEST" width="828" height="372">
            <div class="cert-tag">QAZAQ RESMI TEST CERTIFICATE</div>
          </div>
          <div class="cert-title">СЕРТИФИКАТ</div>
          <hr>
          <div class="cert-f">Аты-жөні: <i class="blank"></i></div>
          <div class="cert-f">Тапсырушы ID: <i class="blank">xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx</i></div>
          <div class="cert-f">Тест тапсырған күні: 25.11.2025</div>
          <hr>
          <div class="cert-mid">
            <div>
              <div class="cert-f">Жарамдылығы: 25.11.2027</div>
              <div class="cert-h">НӘТИЖЕЛЕР:</div>
              <table class="cert-t">
                <tr><th>Бөлім атауы</th><th>Ұпай саны</th></tr>
                <tr><td>Тыңдалым</td><td>10%/10%</td></tr>
                <tr><td>Лексика және орфография</td><td>8%/10%</td></tr>
                <tr><td>Оқылым</td><td>10%/10%</td></tr>
                <tr><td>Жазылым</td><td>21%/35%</td></tr>
                <tr><td>Сұхбат</td><td>7%/35%</td></tr>
                <tr><td>Барлығы</td><td>56%</td></tr>
              </table>
            </div>
            <div>
              <div class="cert-lvl">Деңгейі: B1<br>Орта деңгей</div>
              <div class="cert-qr"><img src="assets/qr-sample.svg" alt=""></div>
            </div>
          </div>
          <hr>
          <div class="cert-h">КӨРСЕТКІШІ:</div>
          <div class="cert-chart"><i style="height:100%"></i><i style="height:80%"></i><i style="height:100%"></i><i style="height:60%"></i><i style="height:20%"></i></div>
          <div class="cert-labels"><span>Тыңдалым</span><span>Лексика және орфография</span><span>Оқылым</span><span>Жазылым</span><span>Сұхбат</span></div>
          <div class="cert-foot"><img class="emb" src="assets/academy-seal.png" alt="Мемлекеттік басқару академиясы"><div>Тестілеу әдіснамасын Қазақстан Республикасы Президентінің жанындағы Мемлекеттік басқару академиясы әзірлеген</div></div>
        </div>
        <div class="cert-stamp short">ҮЛГІ</div>
      </div>
      <figcaption>Сертификат үлгісі</figcaption>
    </figure>
  </div>
</section>
<div class="oyu-divider"><img src="assets/oyu-divider.png" alt="" width="1138" height="65"></div>

<!-- Тест туралы -->
<section id="about">
  <div class="wrap">
    <h2>Тест туралы қысқаша</h2>
    <p class="lead">Тест 5 бөліктен тұрады және 5 тілдік дағдыны тексереді. Нәтижесінде сізге деңгей беріледі (A1-ден C2-ге дейін) және сертификат жіберіледі.</p>
    <div class="stats">
      <div class="fact"><b>7/24</b><span>Тәулік бойы</span></div>
      <div class="fact"><b>18 700 ₸</b><span>Тест құны</span></div>
      <div class="fact"><b>2 күн</b><span>Нәтиже 2 жұмыс күн ішінде</span></div>
      <div class="fact"><b>A1–C2</b><span>CEFR, 6 деңгей</span></div>
    </div>
    <div class="grid g3 mt">
      <div class="card"><div class="ico">💻</div><h3>Толық онлайн</h3><p>Ешқайда барудың қажеті жоқ. Тестті өзіңізге ыңғайлы уақытта тапсырасыз.</p></div>
      <div class="card"><div class="ico">📜</div><h3>Сертификат жеке кабинетте</h3><p>Нәтижемен бірге сертификат келеді. Оны қалаған уақытта жүктеп алуға болады.</p></div>
      <div class="card"><div class="ico">🔁</div><h3>Қайта тапсыруға болады</h3><p>Тестті қалауыңызша бірнеше рет тапсыра беруге болады.</p></div>
    </div>
    <div class="note"><b>CEFR</b> — кез келген тілді білу деңгейін бағалайтын халықаралық жүйе. Тест әдістемесі қазақ тілінің Ұлттық стандарттары негізінде жасалған: СТ РК 1927-2015, СТ РК 1925-2015, СТ РК 1929-2015.</div>
  </div>
</section>

<!-- Қадамдар -->
<section id="steps" class="alt">
  <div class="wrap">
    <h2>Тестті қалай тапсырамын? 4 қадам</h2>
    <div class="grid g4 mt">
      <div class="card"><div class="num">1</div><h3>Тіркелу</h3><p>Сайтта жеке кабинет ашыңыз.</p></div>
      <div class="card"><div class="num">2</div><h3>Төлем жасау</h3><p>Тест құны — 18 700 теңге.</p></div>
      <div class="card"><div class="num">3</div><h3>Тест тапсыру</h3><p>Жүйеге кіріп, 5 бөлікті ретімен орындаңыз.</p></div>
      <div class="card"><div class="num">4</div><h3>Сертификат алу</h3><p>2 жұмыс күні ішінде нәтиже мен сертификат жеке кабинетке келеді.</p></div>
    </div>
    <div class="warn"><b>Маңызды!</b> Барлық 5 бөлікті <b>бір кіргенде, бірден</b> орындау керек. Тестті бастамас бұрын уақытыңызды (шамамен 1 сағат) алдын ала белгілеп алыңыз.</div>
    <p class="mt"><a class="btn btn-blue" href="https://test.qrt.kz/register">Қазір тіркелу →</a></p>
  </div>
</section>

<!-- Тест құрылымы -->
<section id="structure">
  <div class="wrap">
    <h2>Тест неден тұрады?</h2>
    <p class="lead">5 бөлік, барлығы 60 минут. Бөліктерді платформада тұрған ретімен орындайсыз.</p>
    <div class="mt">
      <div class="part"><div class="n ico-n">🎧</div><div><h3>Тыңдалым</h3><p>1,5–2 минуттық видео материалдың негізгі идеясын түсіну деңгейі сұрақтарға жауап беру арқылы анықталады.</p></div><div class="meta"><b>10%</b><span>5 сұрақ<br>10 минут</span></div></div>
      <div class="part"><div class="n ico-n">🔤</div><div><h3>Лексика-орфография</h3><p>Орфоэпиялық, орфографиялық, лексикалық, грамматикалық нормаларды білу деңгейі анықталады.</p></div><div class="meta"><b>10%</b><span>10 сұрақ<br>10 минут</span></div></div>
      <div class="part"><div class="n ico-n">📖</div><div><h3>Оқылым</h3><p>Әртүрлі мазмұндағы мәтіндерді оқу және негізгі мәселелерді түсіну дағдысы анықталады.</p></div><div class="meta"><b>10%</b><span>1 мәтін / 10 сұрақ<br>15 минут</span></div></div>
      <div class="part big"><div class="n ico-n">✍️</div><div><h3>Жазылым</h3><p>Негізгі ойдың өзектілігін ашып, аргументті мәтін құрастыру дағдысы анықталады.</p></div><div class="meta"><b>35%</b><span>Кемінде 10 сөйлем<br>15 минут</span></div></div>
      <div class="part big"><div class="n ico-n">🗣️</div><div><h3>Сұхбат</h3><p>Берілген сұрақтарға 5–10 минут ішінде аргументті жауап беру дағдысы анықталады.</p></div><div class="meta"><b>35%</b><span>3 сұрақ<br>10 минут</span></div></div>
    </div>
    <div class="note"><b>Кеңес:</b> Жазылым мен сұхбат жалпы бағалаудың 70%-ын құрайды. Сондықтан осы бөлімдерге басымдық беріңіз.</div>
  </div>
</section>

<!-- Тест кезінде -->
<section id="rules" class="alt">
  <div class="wrap">
    <h2>Тест кезінде нені білу керек?</h2>
    <div class="grid g3 mt">
      <div class="card"><div class="ico">🎥</div><h3>Камера мен микрофон</h3><p>Тест кезінде аудио және бейне бақылау жүргізіледі. Компьютерден бөлек смартфон керек — ол 360° камера ретінде бөлмені түсіріп тұрады.</p><p><a href="nuskaulyk.html">Нұсқаулықты оқу →</a></p></div>
      <div class="card"><div class="ico">🚫</div><h3>Басқа терезе ашпаңыз</h3><p>Жүйе басқа бағдарламаларды, терезелерді және құрылғыларды пайдалануға мүмкіндік бермейді. Ереже бұзылса, нәтиже автоматты түрде жойылады.</p></div>
      <div class="card"><div class="ico">🔒</div><h3>Әділ бағалау</h3><p>Жұмыстарды тәуелсіз сарапшылар тексереді. Олар сіздің атыңызды көрмейді — тек 32 таңбалы шифрды көреді.</p></div>
    </div>
  </div>
</section>

<!-- Деңгейлер -->
<section id="levels">
  <div class="wrap">
    <h2>Деңгейлер және сертификат мерзімі</h2>
    <p class="lead">Жинаған пайызыңызға қарай деңгей беріледі.</p>
    <div class="grid g3 mt">
{% for l in levels.kz %}
      <div class="lvl {{ l.code | lower }}"><div class="code">{{ l.code }}</div><div class="name">{{ l.name }}</div><div class="desc">{{ l.desc }}</div><ul><li><span>{{ levels.labels_kz.result }}</span><b>{{ l.result }}</b></li><li><span>{{ levels.labels_kz.term }}</span><b>{{ l.term }}</b></li></ul></div>
{% endfor %}
    </div>
    <p class="mt"><a class="btn btn-blue" href="https://certificate.qrt.kz/certificate">Сертификатты тексеру →</a></p>
  </div>
</section>

<!-- Кімге керек -->
<section id="users" class="alt">
  <div class="wrap">
    <h2>Сертификат кімге керек?</h2>
    <p class="lead">Жүйені мына ұйымдар мен үміткерлер қолданады:</p>
    <div class="orgs mt">
{% include "orgs.njk" %}
    </div>
    <p class="mt"><a class="btn btn-blue" href="zhuye.html#users">Барлық қолданушылар мен құжаттар →</a></p>
  </div>
</section>

<!-- Баға -->
<section id="price">
  <div class="wrap">
    <h2>Тест бағасы</h2>
    <p class="lead">Өзіңізге ыңғайлы тәсілді таңдаңыз.</p>
    <div class="tariffs mt">
      <div class="tariff">
        <div class="t-name">Стандарт</div>
        <div class="price">{{ tariffs.standard_price }}</div>
        <ul class="checks">
{% for i in tariffs.kz.standard %}          <li>{{ i }}</li>
{% endfor %}        </ul>
        <a class="btn btn-blue" href="https://test.qrt.kz/register">Тіркелу →</a>
      </div>
      <div class="tariff hot">
        <div class="badge">{{ tariffs.kz.badge }}</div>
        <div class="t-name">Экспресс</div>
        <div class="price">{{ tariffs.express_price }}</div>
        <ul class="checks">
{% for i in tariffs.kz.express %}          <li>{{ i }}</li>
{% endfor %}        </ul>
        <a class="btn btn-main" href="https://test.qrt.kz/register">Тіркелу →</a>
      </div>
    </div>
    <div class="promo">
      <div class="promo-ico">🎟️</div>
      <div>
        <h3>Промокодыңыз бар ма?</h3>
        <p>Кейбір мекемелер мен бағдарламалар аясында тестілеуді тегін немесе жеңілдікпен тапсыруға мүмкіндік беретін промокодтар беріледі.</p>
        <ol class="promo-steps">
          <li><b>Промокодты алыңыз</b> — оны сізді тестке жіберген мекеме немесе бағдарлама береді.</li>
          <li><b>test.qrt.kz-те тіркеліңіз</b> және промокодты арнайы жолға енгізіңіз.</li>
          <li><b>Тестті тапсырыңыз</b> — промокод бағаны азайтады немесе тестті тегін етеді.</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<!-- Дайындық -->
<section id="prep" class="alt">
  <div class="wrap">
    <h2>Тестке дайындық</h2>
    <div class="grid g2 mt">
      <div class="card">
        <div class="ico">📘</div><h3>Әдістемелік құрал</h3>
        <p>Тестке қалай дайындалу керегін түсіндіретін құрал (ISBN 978-601-287-226-2).</p>
        <p><a href="https://qrt.kz/images/adis_nus_kz.pdf">PDF-ті ашу →</a></p>
      </div>
      <div class="card">
        <div class="ico">👩‍🏫</div><h3>Дайындық курстары</h3>
        <p>QAZAQ RESMI TEST-ке тек ҚР Президенті жанындағы Мемлекеттік басқару академиясы дайындайды. Ақылы 24 және 36 сағаттық курстар бар, жеке немесе топпен.</p>
        <p>Телефон: <a href="tel:{{ settings.phone_tel }}"><b>{{ settings.phone }}</b></a></p>
      </div>
    </div>
  </div>
</section>

<!-- Сұрақ-жауап -->
<section id="faq">
  <div class="wrap">
    <h2>Жиі қойылатын сұрақтар</h2>
    <div class="mt">
      <div class="faq-col">
{% for f in faq.kz_left %}
        <details{% if f.id %} id="{{ f.id }}"{% endif %}><summary>{{ f.q | safe }}</summary><div class="ans">{{ f.a | safe }}</div></details>
{% endfor %}
      </div>
      <div class="faq-col">
{% for f in faq.kz_right %}
        <details{% if f.id %} id="{{ f.id }}"{% endif %}><summary>{{ f.q | safe }}</summary><div class="ans">{{ f.a | safe }}</div></details>
{% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- Жаңалықтар -->
<section id="news" class="alt">
  <div class="wrap">
    <h2>Жаңалықтар</h2>
    <div class="news-grid mt">
{% for n in collections.news_kz | head(3) %}
      <a class="news-card" href="zhanalyqtar.html#n{{ loop.index }}">
        <img src="{{ n.data.image }}" alt=""{{ n.data.image | imgsize | safe }}>
        <div class="nc-body"><div class="date">{{ n.date | kzdate }}</div><h3>{{ n.data.title }}</h3><span class="more">{{ "Толығырақ" if "kz" == "kz" else "Подробнее" }} →</span></div>
      </a>
{% endfor %}
    </div>
    <p class="mt"><a class="btn btn-blue" href="zhanalyqtar.html">Барлық жаңалықтар →</a></p>
  </div>
</section>

<!-- Байланыс -->
<section id="contact" class="contact">
  <div class="wrap">
    <h2>Байланыс</h2>
    <p class="lead">Сұрағыңыз болса, жазыңыз — көмектесеміз.</p>
    <div class="grid g4 mt">
      <div class="card card-link"><div class="ico">📞</div><h3>Телефон</h3><a href="tel:{{ settings.phone_tel }}">{{ settings.phone }}</a></div>
      <div class="card card-link"><div class="ico">💬</div><h3>WhatsApp</h3><a href="https://wa.me/{{ settings.whatsapp | digits }}">{{ settings.whatsapp }}</a></div>
      <div class="card card-link"><div class="ico">✉️</div><h3>Пошта</h3><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></div>
      <div class="card card-link"><div class="ico">📷</div><h3>Instagram</h3><a href="https://www.instagram.com/{{ settings.instagram }}/">@{{ settings.instagram }}</a></div>
    </div>
    <p class="mt">📍 {{ settings.address_kz }}</p>
  </div>
</section>

<footer>
  <div class="wrap foot">
    <div>© 2026 QAZAQ RESMI TEST<br>ISBN 978-601-287-226-2</div>
    <div class="foot-links">
      <a href="nuskaulyk.html">Нұсқаулық</a>
      <a href="https://test.qrt.kz/register">Тіркелу</a>
