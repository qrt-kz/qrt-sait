        <h2>{{ n.data.title }}</h2>
{{ n.content | safe }}{% if n.data.links and n.data.links.length %}        <div class="chips">{% for l in n.data.links %}<a class="chip" href="{{ l.url }}" target="_blank" rel="noopener">🔗 {{ l.text }}</a>{% endfor %}</div>
{% endif %}      </div>
