<script>
  // Мәзір: ашу/жабу
  const burger = document.querySelector('.burger');
  const menu = document.querySelector('.menu');
  burger.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
  });
  menu.addEventListener('click', e => {
    if (e.target.tagName === 'A') { menu.classList.remove('open'); burger.setAttribute('aria-expanded', false); }
  });

  // Актілер санаттары: басқанда тек сол санат көрінеді
  const tabs = document.querySelectorAll('.act-tabs button');
  const groups = document.querySelectorAll('.act-group');
  const show = i => {
    tabs.forEach((b, j) => b.setAttribute('aria-selected', i === j));
    groups.forEach((g, j) => g.hidden = i !== j);
  };
  tabs.forEach((b, i) => b.addEventListener('click', () => show(i)));
  show(0);
</script>
