{% for o in orgs[lang] %}
      {% if o.url %}<a class="org" href="{{ o.url }}" target="_blank" rel="noopener"><img src="{{ o.logo }}" alt="" width="64" height="64"><span>{{ o.text }}</span><i aria-hidden="true">↗</i></a>{% else %}<div class="org"><img src="{{ o.logo }}" alt="" width="64" height="64"><span>{{ o.text }}</span></div>{% endif %}
{% endfor %}